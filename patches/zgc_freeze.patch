index 00000000..9260da31
--- /dev/null
+++ b/src/hotspot/share/gc/z/zFreeze.cpp
@@ -0,0 +1,195 @@
+/*
+ * Copyright (c) 2024, Oracle and/or its affiliates. All rights reserved.
+ * DO NOT ALTER OR REMOVE COPYRIGHT NOTICES OR THIS FILE HEADER.
+ *
+ * This code is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 2 only, as
+ * published by the Free Software Foundation.
+ *
+ * This code is distributed in the hope that it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+ * version 2 for more details (a copy is included in the LICENSE file that
+ * accompanied this code).
+ *
+ * You should have received a copy of the GNU General Public License version
+ * 2 along with this work; if not, write to the Free Software Foundation,
+ * Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301 USA.
+ *
+ * Please contact Oracle, 500 Oracle Parkway, Redwood Shores, CA 94065 USA
+ * or visit www.oracle.com if you need additional information or have any
+ * questions.
+ */
+
+#include "precompiled.hpp"
+#include "gc/shared/gc_globals.hpp"
+#include "gc/z/zFreeze.hpp"
+
+// Bump on every change to the ZFreeze patch. Printed by the "watching trigger
+// file" line at startup, which is the only reliable way to tell which build of
+// the patch is running: hotspot's "built on" timestamp comes from
+// HOTSPOT_BUILD_TIME, fixed when configure runs, and does not change on rebuild.
+//
+// Deliberately in the .cpp - a version bump must not force a header rebuild.
+#define ZFREEZE_VERSION "v10.2"
+#include "gc/z/zHeap.inline.hpp"
+#include "gc/z/zPage.inline.hpp"
+#include "logging/log.hpp"
+#include "runtime/atomic.hpp"
+#include "runtime/os.hpp"
+#include "runtime/safepoint.hpp"
+#include "utilities/globalDefinitions.hpp"
+
+volatile int    ZFreeze::_state           = ZFreeze::Uninitialized;
+jlong           ZFreeze::_next_poll_millis = 0;
+size_t          ZFreeze::_frozen_pages    = 0;
+size_t          ZFreeze::_frozen_bytes    = 0;
+volatile size_t ZFreeze::_rooted_pages   = 0;
+volatile size_t ZFreeze::_rooted_fields   = 0;
+
+const char* ZFreeze::state_name(int state) {
+  switch (state) {
+  case Uninitialized: return "Uninitialized";
+  case Disabled:      return "Disabled";
+  case Watching:      return "Watching";
+  case Compacting:    return "Compacting";
+  case Arming:        return "Arming";
+  case Frozen:        return "Frozen";
+  default:            return "Unknown";
+  }
+}
+
+bool ZFreeze::is_enabled() {
+  const int state = Atomic::load(&_state);
+  return state != Disabled && state != Uninitialized;
+}
+
+bool ZFreeze::is_frozen() {
+  return Atomic::load(&_state) == Frozen;
+}
+
+void ZFreeze::initialize() {
+  if (ZFreezePath == nullptr || ZFreezePath[0] == '\0') {
+    Atomic::store(&_state, (int)Disabled);
+    return;
+  }
+
+  // Create the trigger file. Its contents are irrelevant; only its existence
+  // matters. Deleting it requests the freeze.
+  FILE* const file = os::fopen(ZFreezePath, "w");
+  if (file == nullptr) {
+    log_warning(gc)("ZFreeze: could not create trigger file %s, freezing disabled", ZFreezePath);
+    Atomic::store(&_state, (int)Disabled);
+    return;
+  }
+  fprintf(file, "delete this file to freeze the ZGC old generation live set\n");
+  fclose(file);
+
+  // Version marker. The hotspot "built on" timestamp is fixed at configure time
+  // (make/autoconf/hotspot.m4 HOTSPOT_BUILD_TIME), so it cannot be used to tell
+  // one build of this patch from another. This line can.
+  log_info(gc, init)("ZFreeze[%s]: watching trigger file %s (delete it to freeze)",
+                     ZFREEZE_VERSION, ZFreezePath);
+  Atomic::store(&_state, (int)Watching);
+}
+
+bool ZFreeze::poll() {
+  int state = Atomic::load(&_state);
+
+  if (state == Uninitialized) {
+    initialize();
+    state = Atomic::load(&_state);
+  }
+
+  if (state == Disabled || state == Frozen) {
+    return false;
+  }
+
+  // Throttle the file system probe.
+  const jlong now = os::javaTimeMillis();
+  if (now < _next_poll_millis) {
+    return false;
+  }
+  _next_poll_millis = now + (jlong)ZFreezeMinPollMillis;
+
+  if (state == Watching) {
+    if (os::file_exists(ZFreezePath)) {
+      return false;
+    }
+    log_info(gc)("ZFreeze: trigger file %s removed, requesting a compacting "
+                 "major collection before freezing", ZFreezePath);
+    Atomic::store(&_state, (int)Compacting);
+    return true;
+  }
+
+  // Compacting or Arming: keep asking for major collections until the state
+  // machine has advanced through both old mark starts.
+  return true;
+}
+
+void ZFreeze::on_old_mark_start() {
+  assert(SafepointSynchronize::is_at_safepoint(), "Must be at safepoint");
+
+  const int state = Atomic::load(&_state);
+  if (state == Disabled || state == Uninitialized) {
+    return;
+  }
+
+  // Keep every frozen live map stamped with this generation's new sequence
+  // number so it is never reset. Must run after ZGenerationOld::mark_start()
+  // has incremented _seqnum.
+  ZHeap::heap()->refresh_permanent_livemaps();
+
+  if (state == Compacting) {
+    log_info(gc, heap)("ZFreeze: compacting collection started, will freeze at the next old mark end");
+    Atomic::store(&_state, (int)Arming);
+  }
+
+}
+
+void ZFreeze::on_old_mark_end() {
+  assert(SafepointSynchronize::is_at_safepoint(), "Must be at safepoint");
+
+  if (Atomic::load(&_state) != Arming) {
+    return;
+  }
+
+  ZHeap::heap()->freeze_permanent_pages(&_frozen_pages, &_frozen_bytes);
+  Atomic::store(&_state, (int)Frozen);
+
+
+  log_info(gc, heap)("ZFreeze: froze " SIZE_FORMAT " page(s), " SIZE_FORMAT "M. "
+                     "Their live maps are pinned, so marking stops at them naturally.",
+                     _frozen_pages, _frozen_bytes / M);
+}
+
+void ZFreeze::mark_permanent_roots() {
+  if (!is_frozen()) {
+    return;
+  }
+
+  size_t pages = 0;
+  size_t fields = 0;
+  ZHeap::heap()->mark_permanent_page_roots(&pages, &fields);
+
+  Atomic::store(&_rooted_pages, pages);
+  Atomic::store(&_rooted_fields, fields);
+
+  if (pages > 0) {
+    log_info(gc, heap)("ZFreeze: scanned " SIZE_FORMAT " field(s) written into "
+                       SIZE_FORMAT " permanent page(s) as marking roots",
+                       fields, pages);
+  }
+}
+
+void ZFreeze::print_stats() {
+  if (!is_enabled()) {
+    return;
+  }
+
+  log_info(gc, heap)("ZFreeze: state=%s frozen=" SIZE_FORMAT "M/" SIZE_FORMAT " pages "
+                     "root-scanned=" SIZE_FORMAT " fields/" SIZE_FORMAT " pages",
+                     state_name(Atomic::load(&_state)),
+                     _frozen_bytes / M, _frozen_pages,
+                     Atomic::load(&_rooted_fields), Atomic::load(&_rooted_pages));
+}
