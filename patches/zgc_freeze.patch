+void ZPage::init_permanent_write_set() {
+  assert(SafepointSynchronize::is_at_safepoint(), "Must be at safepoint");
+
+  // Must run BEFORE prepare_permanent_colours(): that pass records freeze-time
+  // out-edges through note_permanent_store(), which writes into this bitmap.
