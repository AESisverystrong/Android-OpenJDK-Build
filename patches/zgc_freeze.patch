+    _iterator.do_pages([&](ZPage* page) {
+      if (page->is_permanent() && page->is_permanent_written()) {
+        page->object_do_permanent_written([&](oop obj) {
+          _mark->push_follow_only(to_zaddress(obj));
+          objects++;
+        });
+        pages++;
