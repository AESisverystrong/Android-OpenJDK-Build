+
+void ZPage::make_permanent() {
+  assert(SafepointSynchronize::is_at_safepoint(), "Must be at safepoint");
+  assert(!is_permanent(), "Already permanent");
+
+  guarantee(_permanent_writes.size() != 0, "init_permanent_write_set() must run first");
