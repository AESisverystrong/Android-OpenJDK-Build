+ * 2 along with this work; if not, write to the Free Software Foundation,
+ * Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301 USA.
+ *
+ * Please contact Oracle, 500 Oracle Parkway, Redwood Shores, CA 94065 USA
+ * or visit www.oracle.com if you need additional information or have any
+ * questions.
+ */
+
+#ifndef SHARE_GC_Z_ZFREEZE_HPP
+#define SHARE_GC_Z_ZFREEZE_HPP
+
+#include "memory/allocation.hpp"
+#include "utilities/globalDefinitions.hpp"
+
+// ZFreeze implements a one-shot, externally triggered "freeze" of the current
+// old generation live set into permanent pages.
+//
+// A permanent page (see ZPage::is_permanent()) is unconditionally live. It is
+// never marked, never traversed by marking, never relocated and never freed.
+// The startup-loaded working set of a long running application is typically a
+// large, effectively immutable object graph; excluding it from marking removes
+// it from the cost of every subsequent old collection, at the price of never
+// reclaiming anything inside it.
+//
+// Correctness rests on two properties:
+//
+//  1. At freeze time the frozen set is closed. Freezing happens at a
+//     safepoint and freezes whole pages, and everything reachable from an old
+//     page at that instant is itself in an old page, so no out-edge into
+//     collectable space can exist at freeze time.
+//
+//  2. Any later reference store into a permanent page could create such an
+//     out-edge, so the store barrier records it on that page
+//     (ZPage::note_permanent_store()). From the next old marking cycle on,
+//     every reference field of that page is handed to the mark closure as a
+//     ROOT, in ZFreeze::mark_permanent_roots().
+//
+//     Roots are required here, not ordinary marking. Letting the page be marked
+//     and traversed again would not work, because marking only ever reaches a
+//     page by traversing a pointer to it, and a page inside the frozen set can
+//     be reachable only from other permanent pages - which are never traversed.
+//     Marking would simply never arrive, and the out-edge would still be
+//     missed.
+//
+//     A store that happens while old marking is already running is additionally
+//     covered by the store barrier itself, which marks the stored value.
+//
+// The trigger is a file whose path is given by -XX:ZFreezePath. ZGC creates
+// the file lazily and then polls it; deleting the file requests the freeze.
+// A file is used rather than jcmd because the attach mechanism is not reliably
+// available on all platforms.
+//
+// The state machine deliberately spends one full major collection compacting
+// before it freezes, so that the pages that become permanent are densely
+// populated and little garbage is captured:
+//
+//   Watching --(file deleted)--> Compacting --(old mark start)-->
+//   Arming --(old mark start)--> Frozen
+//
+// Nothing inside a permanent page is ever reclaimed, so this trades memory for
+// marking work. That is the intended trade.
+class ZFreeze : public AllStatic {
+public:
+  enum State {
+    Uninitialized,
+    Disabled,
+    Watching,
+    Compacting,
+    Arming,
+    Frozen
+  };
+
+private:
+  static volatile int    _state;
+  static jlong           _next_poll_millis;
+  static size_t          _frozen_pages;
+  static size_t          _frozen_bytes;
+  static volatile size_t _rooted_pages;
+  static volatile size_t _rooted_bytes;
+
+  static void initialize();
+  static const char* state_name(int state);
+
+public:
+  static bool is_enabled();
+  static bool is_frozen();
+
+  // Called from ZDirector's main loop, outside of safepoints. Returns true if
+  // a major collection should be started to drive the state machine forward.
+  static bool poll();
+
+  // Called at a safepoint from ZGenerationOld::mark_start(). Performs the
+  // freeze once the state machine is armed.
+  static void on_old_mark_start();
+
+  // Called from ZGenerationOld::mark_roots(), concurrently. Feeds every
+  // reference field of every written-to permanent page into the mark closure as
+  // a root.
+  static void mark_permanent_roots();
+
+  // Statistics, reported through the gc log.
+  static void print_stats();
+};
+
+#endif // SHARE_GC_Z_ZFREEZE_HPP
