+    // cannot be walked (ZIterator::oop_iterate_safe() skips exactly these). Do
+    // not try to classify it - register it unconditionally instead, so that it
+    // keeps being traversed by normal marking from now on. This is strictly
+    // safer than the alternative of leaving the whole page out of the frozen
+    // set, and it cannot lose an out-edge.
+    if (obj->klass()->is_objArray_klass() && obj->mark_acquire().is_marked()) {
+      note_permanent_store((volatile zpointer*)untype(to_zaddress(obj)));
+      objects++;
+      return;
+    }
