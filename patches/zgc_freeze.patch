+
+bool ZPage::can_be_frozen(size_t* uncolourable) {
+  assert(SafepointSynchronize::is_at_safepoint(), "Must be at safepoint");
+  assert(is_marked(), "Live map must be valid - freeze runs at old mark end");
+
+  // Header-only walk. ZIterator::oop_iterate_safe() silently skips objects whose
+  // mark word currently holds a forwarding pointer, so a page containing one
+  // cannot be fully re-coloured, and a partially coloured page keeps store-good
+  // fields whose stores are invisible to the freeze machinery. Such a page is
+  // left out of the frozen set entirely.
+  //
+  // This has to be a separate pass. Eligibility for the whole frozen set must be
+  // final before any colouring starts, because the colour pass decides whether
+  // an edge leaves the set by asking target->is_permanent(). Un-freezing a page
+  // after other pages have already been coloured is not possible: edges into it
+  // would have been treated as internal and never registered as roots.
+  size_t bad = 0;
+
+  object_iterate([&](oop obj) {
+    if (obj->klass()->is_objArray_klass() && obj->mark_acquire().is_marked()) {
+      bad++;
+    }
+  });
+
+  *uncolourable = bad;
+
+  return bad == 0;
+}
+
+size_t ZPage::prepare_permanent_colours() {
+  assert(SafepointSynchronize::is_at_safepoint(), "Must be at safepoint");
+  assert(is_permanent(), "Whole frozen set must be marked permanent first");
+  assert(is_marked(), "Live map must be valid - freeze runs at old mark end");
+
+  // Walk LIVE objects only, via ZGC's own live-map driven iterator. Walking the
+  // page linearly from start() to top() would also touch dead objects, whose
+  // fields hold long-stale pointers; applying a barrier to those manufactures
+  // good-coloured pointers into freed pages.
+  size_t coloured = 0;
+
+  object_iterate([&](oop obj) {
+    guarantee(!(obj->klass()->is_objArray_klass() && obj->mark_acquire().is_marked()),
+              "can_be_frozen() should have excluded this page");
+
+    ZIterator::basic_oop_iterate_safe(obj, [&](volatile zpointer* p) {
+      // Remap and re-colour. load_barrier_on_oop_field() remaps through the
+      // forwarding tables and self-heals via ZAddress::load_good(), which sets
+      // ZPointerRememberedMask - both remembered bits. That is always store-bad,
+      // because ZPointerStoreBadMask carries the other one, so the next store to
+      // this field is forced onto the slow path where ZPage::remember() and
+      // note_permanent_store() run. The field stays load-good and mark-good, so
+      // application reads keep the fast path.
+      const zaddress addr = ZBarrier::load_barrier_on_oop_field(p);
+
+      // Then record any edge that ALREADY leaves the frozen set.
+      //
+      // Such an edge was not produced by a post-freeze store, so the store
+      // barrier will never report it. While its target is young the remembered
+      // set covers it, but the moment the target is promoted
+      // ZRemembered::scan_field() drops the entry - it only re-registers targets
+      // that are still young - and then nothing knows the edge exists. The
+      // target is eventually collected while a frozen field still points at it,
+      // and the next store to that field takes the store barrier slow path,
+      // buffers the stale value, and ZStoreBarrierBuffer::flush() dereferences a
+      // page table entry that is now nullptr.
+      //
+      // The test is target->is_permanent(), which is why the whole frozen set
+      // has to be marked permanent before this pass runs. Testing it while pages
+      // were still being marked one at a time made every edge into a
+      // not-yet-processed page look outgoing: 37.5M of 109M fields registered as
+      // roots, re-scanned on every later old marking cycle.
+      if (!is_null(addr)) {
+        const ZPage* const target = ZHeap::heap()->page(addr);
+        if (target == nullptr || !target->is_permanent()) {
+          note_permanent_store(p);
+        }
+      }
+
+      coloured++;
+    });
+  });
+
+  return coloured;
+}
+
+void ZPage::keep_livemap_current() {
+  assert(SafepointSynchronize::is_at_safepoint(), "Must be at safepoint");
+  assert(is_permanent(), "Only permanent pages");
+  // ZLiveMap::is_marked() is just _seqnum == generation->seqnum(). Re-stamping
+  // it every old mark start keeps the frozen live map valid forever, so
+  // is_marked(), live_bytes(), find_base(), object_iterate() and the
+  // ZRemembered::scan_page() branch selection all keep working. That is what
+  // removes the need for the special cases this patch used to carry.
+  _livemap.refresh_seqnum(generation_id());
+}
