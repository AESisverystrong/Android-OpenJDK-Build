 #include "gc/z/zDriver.hpp"
 #include "gc/z/zForwarding.hpp"
 #include "gc/z/zForwardingTable.inline.hpp"
+#include "gc/z/zFreeze.hpp"
 #include "gc/z/zGeneration.inline.hpp"
 #include "gc/z/zHeap.inline.hpp"
 #include "gc/z/zJNICritical.hpp"
@@ -1209,6 +1210,12 @@ void ZGenerationOld::mark_start() {
   // Increment sequence number
   _seqnum++;
 
+  // Drive the ZFreeze state machine. Must run after retire_pages() and after
+  // the sequence number has been incremented (so that the pinned live maps are
+  // re-stamped with the new sequence number), and before marking starts.
+  ZFreeze::on_old_mark_start();
+  ZFreeze::print_stats();
+
   // Enter mark phase
   set_phase(Phase::Mark);
 
@@ -1249,6 +1256,10 @@ bool ZGenerationOld::mark_end() {
   // Enter mark completed phase
   set_phase(Phase::MarkComplete);
 
+  // Marking is complete, so every live map is precise. This is where ZFreeze
+  // takes its snapshot.
+  ZFreeze::on_old_mark_end();
+
   // Verify after mark
   ZVerify::after_mark();
 
diff --git a/src/hotspot/share/gc/z/zHeap.cpp b/src/hotspot/share/gc/z/zHeap.cpp
index 21ff70379..749f4b902 100644
--- a/src/hotspot/share/gc/z/zHeap.cpp
+++ b/src/hotspot/share/gc/z/zHeap.cpp
@@ -34,10 +34,12 @@
 #include "gc/z/zHeap.inline.hpp"
 #include "gc/z/zHeapIterator.hpp"
 #include "gc/z/zHeuristics.hpp"
+#include "gc/z/zMark.hpp"
 #include "gc/z/zPage.inline.hpp"
 #include "gc/z/zPageTable.inline.hpp"
 #include "gc/z/zResurrection.hpp"
 #include "gc/z/zStat.hpp"
+#include "gc/z/zTask.hpp"
 #include "gc/z/zUncoloredRoot.inline.hpp"
 #include "gc/z/zUtils.hpp"
 #include "gc/z/zVerify.hpp"
@@ -291,6 +293,176 @@ bool ZHeap::is_allocating(zaddress addr) const {
   return page->is_allocating();
 }
 
+void ZHeap::freeze_permanent_pages(size_t* pages, size_t* bytes) {
+  assert(SafepointSynchronize::is_at_safepoint(), "Should be at safepoint");
+
+  size_t frozen_pages = 0;
+  size_t frozen_bytes = 0;
+  size_t skipped_young_pages = 0;
+  size_t skipped_young_bytes = 0;
+  size_t followed_objects = 0;
+  size_t remembered_fields = 0;
+
+  // ---------------------------------------------------------------------
+  // Pass 1 - decide the frozen set and mark it permanent.
+  //
+  // The whole set must be permanent before pass 2 starts. Pass 2 decides whether
+  // an edge leaves the frozen set by asking target->is_permanent(), so doing both
+  // in one loop would make every edge into a page later in iteration order look
+  // like an outgoing edge.
+  //
+  // ZPageTableIterator already collapses the several granules of a medium or
+  // large page into a single visit.
+  // ---------------------------------------------------------------------
+  {
+    ZPageTableIterator iter(&_page_table);
+    for (ZPage* page; iter.next(&page);) {
+      if (!page->is_old()) {
+        // By the time the freeze runs there should be very little live young
+        // data left: the freezing major collection is requested with
+        // GCCause::_z_freeze, for which should_preclean_young() unconditionally
+        // returns true, so its young phase ran ZYoungType::major_full_preclean
+        // and promoted every live object into the old generation. What remains
+        // was allocated after the pre-clean.
+        //
+        // Whatever is left is genuinely outside the snapshot, which is exactly
+        // why pass 2 registers edges pointing into it - both as objects to keep
+        // following, and as remembered set entries.
+        skipped_young_pages++;
+        skipped_young_bytes += page->size();
+        continue;
+      }
+
+      if (!page->is_relocatable()) {
+        // Still being allocated into. Freezing it would silently turn every
+        // object allocated afterwards into a permanent object as top moves on.
+        continue;
+      }
+
+      page->init_permanent_write_set();
+      page->make_permanent();
+
+      frozen_pages++;
+      frozen_bytes += page->size();
+    }
+  }
+
+  // ---------------------------------------------------------------------
+  // Pass 2 - classify the frozen set.
+  // ---------------------------------------------------------------------
+  {
+    ZPageTableIterator iter(&_page_table);
+    for (ZPage* page; iter.next(&page);) {
+      if (!page->is_permanent()) {
+        continue;
+      }
+
+      size_t objects = 0;
+      size_t remembered = 0;
+      page->classify_permanent_fields(&objects, &remembered);
+
+      followed_objects += objects;
+      remembered_fields += remembered;
+    }
+  }
+
+  log_info(gc, heap)("ZFreeze: " SIZE_FORMAT " object(s) already hold edges out of the "
+                     "frozen set and will keep being traversed; " SIZE_FORMAT
