+void ZHeap::freeze_permanent_pages(size_t* pages, size_t* bytes) {
+  assert(SafepointSynchronize::is_at_safepoint(), "Should be at safepoint");
+
+  size_t frozen_pages = 0;
+  size_t frozen_bytes = 0;
+
+  ZPageTableIterator iter(&_page_table);
+  for (ZPage* page; iter.next(&page);) {
+    // The page table has one entry per granule, so a medium or large page is
+    // visited more than once. Freezing is idempotent thanks to this check.
+    if (page->is_permanent()) {
+      continue;
+    }
+
+    if (!page->is_old()) {
+      // Young pages are still subject to aging and promotion. Only established
+      // old pages are frozen; anything live that is still young will simply be
+      // promoted into ordinary old pages later.
+      continue;
+    }
+
+    if (!page->is_relocatable()) {
+      // Currently being allocated into. Freezing it would silently turn every
+      // object allocated afterwards into a permanent object as _top moves on.
+      continue;
+    }
+
+    page->make_permanent();
+
+    frozen_pages++;
+    frozen_bytes += page->size();
+  }
+
+  *pages = frozen_pages;
+  *bytes = frozen_bytes;
+}
+
+void ZHeap::mark_permanent_page_roots(size_t* pages, size_t* bytes) {
+  assert(ZGeneration::old()->is_phase_mark(), "Should be marking the old generation");
+
+  size_t scanned_pages = 0;
+  size_t scanned_bytes = 0;
+
+  ZPage* previous = nullptr;
+
+  ZPageTableIterator iter(&_page_table);
+  for (ZPage* page; iter.next(&page);) {
+    // A medium or large page occupies several granules, so guard against
+    // scanning the same page more than once.
+    if (page == previous) {
+      continue;
+    }
+    previous = page;
+
+    if (!page->is_permanent() || !page->is_permanent_store_seen()) {
+      continue;
+    }
+
+    // This page received a reference store after it was frozen, so it may hold
+    // an out-edge into collectable space. Nothing traverses a permanent page, so
+    // every reference field on it has to be handed to the mark closure as a
+    // root. All objects on a permanent page are live, which is what makes a
+    // plain linear walk safe here - no liveness information is needed, and none
+    // exists.
+    const uintptr_t start_offset = untype(page->start());
+    const uintptr_t end_offset = untype(page->top());
+
+    for (uintptr_t offset = start_offset; offset < end_offset; ) {
+      const zaddress addr = ZOffset::address(to_zoffset(offset));
+      const size_t size = ZUtils::object_size(addr);
+
+      assert(size > 0, "Zero sized object at " PTR_FORMAT, untype(addr));
+      assert(offset + size <= end_offset, "Object crosses page top");
+
+      ZIterator::basic_oop_iterate_safe(to_oop(addr), [](volatile zpointer* p) {
+        ZBarrier::mark_barrier_on_oop_field(p, false /* finalizable */);
+      });
+
+      offset += size;
+    }
+
+    scanned_pages++;
+    scanned_bytes += page->size();
+  }
+
+  *pages = scanned_pages;
+  *bytes = scanned_bytes;
+}
+
 void ZHeap::object_iterate(ObjectClosure* object_cl, bool visit_weaks) {
   assert(SafepointSynchronize::is_at_safepoint(), "Should be at safepoint");
   ZHeapIterator iter(1 /* nworkers */, visit_weaks, false /* for_verify */);
