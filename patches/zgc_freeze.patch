 void ZGenerationOld::mark_roots() {
   ZStatTimerOld timer(ZSubPhaseConcurrentMarkRootsOld);
   _mark.mark_old_roots();
+
+  // Frozen pages are never traversed, so a reference stored into one after it
+  // was frozen has to enter the mark closure as a root. See ZFreeze.
+  ZFreeze::mark_permanent_roots();
 }
 
 void ZGenerationOld::mark_follow() {
@@ -1249,6 +1262,10 @@ bool ZGenerationOld::mark_end() {
   // Enter mark completed phase
   set_phase(Phase::MarkComplete);
 
+  // Marking is complete, so every live map is precise. This is where ZFreeze
+  // takes its snapshot.
+  ZFreeze::on_old_mark_end();
+
   // Verify after mark
   ZVerify::after_mark();
 
diff --git a/src/hotspot/share/gc/z/zHeap.cpp b/src/hotspot/share/gc/z/zHeap.cpp
index 21ff7037..13ada480 100644
--- a/src/hotspot/share/gc/z/zHeap.cpp
+++ b/src/hotspot/share/gc/z/zHeap.cpp
@@ -28,18 +28,22 @@
 #include "gc/shared/locationPrinter.hpp"
 #include "gc/shared/tlab_globals.hpp"
 #include "gc/z/zAddress.inline.hpp"
+#include "gc/z/zAllocator.inline.hpp"
 #include "gc/z/zArray.inline.hpp"
+#include "gc/z/zBarrier.inline.hpp"
 #include "gc/z/zGeneration.inline.hpp"
 #include "gc/z/zGlobals.hpp"
 #include "gc/z/zHeap.inline.hpp"
 #include "gc/z/zHeapIterator.hpp"
 #include "gc/z/zHeuristics.hpp"
+#include "gc/z/zIterator.inline.hpp"
 #include "gc/z/zPage.inline.hpp"
 #include "gc/z/zPageTable.inline.hpp"
 #include "gc/z/zResurrection.hpp"
 #include "gc/z/zStat.hpp"
 #include "gc/z/zUncoloredRoot.inline.hpp"
 #include "gc/z/zUtils.hpp"
+#include "gc/z/zUtils.inline.hpp"
 #include "gc/z/zVerify.hpp"
 #include "gc/z/zWorkers.hpp"
 #include "logging/log.hpp"
@@ -291,6 +295,189 @@ bool ZHeap::is_allocating(zaddress addr) const {
   return page->is_allocating();
 }
 
+void ZHeap::freeze_permanent_pages(size_t* pages, size_t* bytes) {
+  assert(SafepointSynchronize::is_at_safepoint(), "Should be at safepoint");
+
+  size_t frozen_pages = 0;
+  size_t frozen_bytes = 0;
+  size_t skipped_young_pages = 0;
+  size_t skipped_young_bytes = 0;
+  size_t coloured_fields = 0;
+  size_t registered_pages = 0;
+  size_t incomplete_pages = 0;
+  size_t incomplete_objects = 0;
+
+  // Retire every allocating page first. ZGenerationOld::mark_start() already
+  // retired the old allocator, but eden and the relocation allocators were only
+  // retired back at the young mark start of this collection and have been
+  // allocated into since. Freezing a page whose top is still moving would turn
+  // everything allocated afterwards into a permanent object.
+  ZAllocator::eden()->retire_pages();
+  for (ZPageAge i = ZPageAge::survivor1; i <= ZPageAge::survivor14;
+       i = static_cast<ZPageAge>(static_cast<uint>(i) + 1)) {
+    ZAllocator::relocation(i)->retire_pages();
+  }
+
+  // ---------------------------------------------------------------------
+  // Pass 1 - decide the frozen set and mark it permanent.
+  //
+  // The whole set must be permanent before pass 2 starts. Pass 2 decides
+  // whether an edge leaves the frozen set by asking target->is_permanent(), so
+  // doing both in one loop made every edge into a page later in iteration order
+  // look like an outgoing edge. Measured with the single loop: 37.5M of 109M
+  // reference fields registered as marking roots, all of them re-scanned on
+  // every subsequent old marking cycle, which gives back most of what the
+  // freeze was supposed to save.
+  // ---------------------------------------------------------------------
+  {
+    ZPageTableIterator iter(&_page_table);
+    for (ZPage* page; iter.next(&page);) {
+      // A medium or large page occupies several granules. Once it has been made
+      // permanent the later granules are filtered out here.
+      if (page->is_permanent()) {
+        continue;
+      }
+
+      if (!page->is_old()) {
+        // By the time the freeze runs there should be very little live young
+        // data left: the freezing major collection is requested with a cause for
+        // which should_preclean_young() is true, so its young phase ran
+        // ZYoungType::major_full_preclean and promoted every live object into
+        // the old generation. What remains was allocated after the pre-clean.
+        //
+        // Whatever is left is genuinely outside the snapshot, which is exactly
+        // why pass 2 registers edges pointing into it.
+        skipped_young_pages++;
+        skipped_young_bytes += page->size();
+        continue;
+      }
+
+      if (!page->is_relocatable()) {
+        // Still being allocated into. Freezing it would silently turn every
+        // object allocated afterwards into a permanent object as top moves on.
+        continue;
+      }
+
+      size_t page_uncolourable = 0;
+      if (!page->can_be_frozen(&page_uncolourable)) {
+        incomplete_pages++;
+        incomplete_objects += page_uncolourable;
+        continue;
+      }
+
+      page->init_permanent_write_set();
+      page->make_permanent();
+
+      frozen_pages++;
+      frozen_bytes += page->size();
+    }
+  }
+
+  // ---------------------------------------------------------------------
+  // Pass 2 - re-colour the frozen set and register the edges leaving it.
+  // ---------------------------------------------------------------------
+  {
+    ZPage* previous = nullptr;
+    ZPageTableIterator iter(&_page_table);
+    for (ZPage* page; iter.next(&page);) {
+      // Every page in the set is permanent now, so is_permanent() can no longer
+      // serve as the multi-granule filter.
+      if (page == previous) {
+        continue;
+      }
+      previous = page;
+
+      if (!page->is_permanent()) {
+        continue;
+      }
+
+      coloured_fields += page->prepare_permanent_colours();
+      registered_pages++;
+    }
+  }
+
+  log_info(gc, heap)("ZFreeze: re-coloured " SIZE_FORMAT " reference field(s) on "
+                     SIZE_FORMAT " page(s) so that post-freeze stores take the "
+                     "barrier slow path", coloured_fields, registered_pages);
+
+  if (incomplete_pages > 0) {
+    log_warning(gc)("ZFreeze: " SIZE_FORMAT " page(s) NOT frozen because " SIZE_FORMAT
+                    " object(s) could not be re-coloured (forwarded object arrays). "
+                    "Leaving them out is deliberate; a partially coloured page would "
+                    "hide out-edges.", incomplete_pages, incomplete_objects);
+  }
+
+  if (skipped_young_pages > 0) {
+    log_info(gc, heap)("ZFreeze: skipped " SIZE_FORMAT " young page(s), " SIZE_FORMAT
+                       "M committed, allocated after the pre-clean. Edges from the "
+                       "frozen set into them are registered as marking roots.",
+                       skipped_young_pages, skipped_young_bytes / M);
+  }
+
+  *pages = frozen_pages;
+  *bytes = frozen_bytes;
+}
+
+void ZHeap::refresh_permanent_livemaps() {
+  assert(SafepointSynchronize::is_at_safepoint(), "Should be at safepoint");
+
+  ZPage* previous = nullptr;
+  ZPageTableIterator iter(&_page_table);
+  for (ZPage* page; iter.next(&page);) {
+    if (page == previous) {
+      continue;
+    }
+    previous = page;
+    if (page->is_permanent()) {
+      page->keep_livemap_current();
+    }
+  }
+}
+
+void ZHeap::mark_permanent_page_roots(size_t* pages, size_t* fields) {
+  assert(ZGeneration::old()->is_phase_mark(), "Should be marking the old generation");
+
+  size_t scanned_pages = 0;
+  size_t scanned_fields = 0;
+
+  ZPage* previous = nullptr;
+
+  ZPageTableIterator iter(&_page_table);
+  for (ZPage* page; iter.next(&page);) {
+    // A medium or large page occupies several granules, so guard against
+    // scanning the same page more than once.
+    if (page == previous) {
+      continue;
+    }
+    previous = page;
+
+    if (!page->is_permanent() || !page->is_permanent_written()) {
+      continue;
+    }
+
+    // This page received one or more reference stores after it was frozen, so it
+    // may hold out-edges into collectable space. Nothing traverses a permanent
+    // page, so those fields have to enter the mark closure as roots.
+    //
+    // Note that this walks the recorded FIELDS, not the objects. Walking objects
+    // would mean reproducing ZMark::follow_object - object alignment per page
+    // type, the CLD-claiming and reference-discovering follow closure, the
+    // stack chunk special case, and the split handling for large object arrays.
+    // The store barrier already recorded the exact field addresses, so none of
+    // that is needed, and the cost is proportional to the number of fields
+    // actually written rather than to the size of the page.
+    page->oops_do_permanent_writes([&](volatile zpointer* p) {
+      ZBarrier::mark_barrier_on_oop_field(p, false /* finalizable */);
+      scanned_fields++;
+    });
+
+    scanned_pages++;
+  }
+
+  *pages = scanned_pages;
+  *fields = scanned_fields;
+}
