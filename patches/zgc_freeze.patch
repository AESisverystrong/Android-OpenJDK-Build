+// Feeds every object that has been written to since the freeze into old marking.
+//
+// This is a ZTask run on the old generation's workers rather than work done
+// inline on the driver thread. Two reasons, both load bearing:
+//
+//  - It must be parallel and claimable, because the recorded set grows without
+//    bound over the life of the process.
+//
+//  - It must not iterate the page table with a bare ZPageTableIterator while
+//    pages can be freed underneath it. ZGenerationPagesParallelIterator holds
+//    enable_safe_destroy()/enable_safe_recycle() for its lifetime, which is what
+//    every other concurrent page table walk in ZGC does.
+class ZFreezeRootsTask : public ZTask {
+private:
+  ZMark* const                     _mark;
+  ZGenerationPagesParallelIterator _iterator;
+  volatile size_t                  _pages;
+  volatile size_t                  _objects;
+
+public:
+  ZFreezeRootsTask(ZMark* mark, ZPageTable* page_table, ZPageAllocator* page_allocator)
+    : ZTask("ZFreezeRootsTask"),
+      _mark(mark),
+      _iterator(page_table, ZGenerationId::old, page_allocator),
+      _pages(0),
+      _objects(0) {}
+
+  virtual void work() {
+    size_t pages = 0;
+    size_t objects = 0;
