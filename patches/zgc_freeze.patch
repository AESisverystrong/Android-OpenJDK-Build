+ * This code is distributed in the hope that it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+ * version 2 for more details (a copy is included in the LICENSE file that
+ * accompanied this code).
+ *
+ * You should have received a copy of the GNU General Public License version
+ * 2 along with this work; if not, write to the Free Software Foundation,
+ * Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301 USA.
+ *
+ * Please contact Oracle, 500 Oracle Parkway, Redwood Shores, CA 94065 USA
+ * or visit www.oracle.com if you need additional information or have any
+ * questions.
+ */
+
+#ifndef SHARE_GC_Z_ZFREEZE_HPP
+#define SHARE_GC_Z_ZFREEZE_HPP
+
+#include "memory/allocation.hpp"
+#include "utilities/globalDefinitions.hpp"
+
+class ZMark;
+class ZWorkers;
+
+// ZFreeze implements a one-shot, externally triggered "freeze" of the current
+// old generation live set into permanent pages.
+//
+// A permanent page (see ZPage::is_permanent()) is unconditionally live: it is
+// never selected for relocation, never freed, and its live map is pinned so
+// that marking, on reaching an object on it, sees the object as already marked
+// and stops there instead of traversing its fields. The startup-loaded working
+// set of a long running application is typically a large, effectively immutable
+// object graph; excluding it from marking removes it from the cost of every
+// subsequent old collection, at the price of never reclaiming anything inside
+// it.
+//
+// Correctness rests on three properties.
+//
+//  1. At freeze time the frozen set is the whole live old heap.
+//
+//     The freeze is driven by a major collection requested with a GC cause for
+//     which should_preclean_young() is true, so ZDriverMajor::collect_young()
+//     runs ZYoungType::major_full_preclean - "collect young generation and
+//     promote everything to old generation" - before collect_old() reaches the
+//     old mark end where the freeze happens.
+//
+//     Note that GCCause::_z_freeze is in the *unconditional* return-true group
+//     of should_preclean_young(). Causes such as GCCause::_z_timer fall through
+//     to "return ScavengeBeforeFullGC", which is true by default but is a flag
+//     the user can turn off; the freeze must not depend on it.
+//
+//  2. Every object on a frozen page that is written to after the freeze leaves
+//     the frozen set, in the sense that it is traversed again by every
+//     subsequent old marking cycle.
+//
+//     This is the part that is easy to get wrong. ZGC's colour scheme encodes
+//     "how many relocations behind" a pointer is in two bits per generation,
+//     and those bits are a parity, not a version number. The scheme only works
+//     because of an invariant: between any two relocations of a generation,
+//     every pointer is visited at least once. Upstream maintains that with
+//     three mechanisms - root remapping, old marking traversal, and remembered
+//     set scanning. Freezing a page removes the second one for the pointers on
+//     it. If nothing puts it back, a pointer on a frozen page silently drifts
+//     more than one relocation behind, its parity eventually reads as "good"
+//     again, and the barrier hands out an address whose page was freed long
+//     ago.
+//
+//     So: the store barrier records the exact field address written
+//     (ZPage::note_permanent_store()), and at every old mark roots phase the
+//     recorded fields are converted back to their containing objects, which are
+//     pushed onto the mark stacks as *follow-only* entries. From there ZGC's own
+//     ZMark::follow_object() traverses them exactly like any other old object -
+//     which is what restores the invariant, and what makes partial array
+//     splitting, stack chunks, CLD claiming and reference discovery work
+//     without this code reimplementing any of it.
+//
+//     Object granularity, not field granularity, is deliberate. Field
+//     granularity would require this code to apply the mark barrier to
+//     individual fields, which bypasses all of the above - most visibly, a
+//     written java.lang.ref.Reference.referent would be marked strongly and its
+//     soft/weak/phantom semantics would be lost.
+//
+//  3. Old-to-young edges out of frozen pages keep a remembered set entry.
+//
+//     Following an object at old mark roots does not keep a young target alive:
+//     ZBarrier::mark() dispatches to young()->mark_object_if_active(), which is
+//     a no-op while young marking is not running. Young targets survive only
+//     through the remembered set, so the freeze pass explicitly registers a
+//     remembered set entry for every old-to-young edge it finds rather than
+//     assuming the store barrier already left one there.
+//
+// The trigger is a file whose path is given by -XX:ZFreezePath. ZGC creates the
+// file lazily and then polls it; deleting the file requests the freeze. A file
+// is used rather than jcmd because the attach mechanism is not reliably
+// available on all platforms, and because the request must not be affected by
+// unrelated flags: the collection is started from inside ZDirector rather than
+// through CollectedHeap::collect(), so -XX:+DisableExplicitGC (which is only
+// ever checked in JVM_GC) cannot block it.
+//
+// The state machine deliberately spends one full major collection compacting
+// before it freezes, so that the pages that become permanent are densely
+// populated and little garbage is captured:
+//
+//   Watching --(file deleted)--> Compacting --(old mark start)-->
+//   Arming --(old mark end)--> Frozen
+//
+// Nothing inside a permanent page is ever reclaimed, so this trades memory for
+// marking work. That is the intended trade.
+class ZFreeze : public AllStatic {
+public:
+  enum State {
+    Uninitialized,
+    Disabled,
+    Watching,
+    Compacting,
+    Arming,
+    Frozen
+  };
+
+private:
+  static volatile int    _state;
+  static jlong           _next_poll_millis;
+  static size_t          _frozen_pages;
+  static size_t          _frozen_bytes;
+  static volatile size_t _followed_pages;
+  static volatile size_t _followed_objects;
+
+  static void initialize();
+  static const char* state_name(int state);
+
+public:
+  static bool is_enabled();
+  static bool is_frozen();
+
+  // Called from ZDirector's main loop, outside of safepoints. Returns true if
+  // a major collection should be started to drive the state machine forward.
+  static bool poll();
+
+  // Called at a safepoint from ZGenerationOld::mark_start(), after the sequence
+  // number has been incremented. Re-stamps the pinned live maps and advances the
+  // state machine.
+  static void on_old_mark_start();
+
+  // Called at a safepoint from ZGenerationOld::mark_end(), where marking is
+  // complete and every live map is precise. This is where the freeze happens.
+  static void on_old_mark_end();
+
+  // Called from ZMark::mark_old_roots(), *inside* its SuspendibleThreadSetJoiner.
+  // That joiner is what keeps safepoints - and therefore colour flips, forwarding
+  // table teardown and page frees - out of the root scanning window; running this
+  // outside of it corrupts pointers.
+  static void mark_permanent_roots(ZMark* mark, ZWorkers* workers);
+
+  // Statistics, reported through the gc log.
+  static void print_stats();
+};
+
+#endif // SHARE_GC_Z_ZFREEZE_HPP
