+      // it with ZAddress::mark_good(), which sets both remembered bits while
+      // ZPointerStoreGoodMask carries only one. So the next store to it takes the
+      // slow path and reaches ZPage::remember(). There is deliberately no
+      // re-colouring pass here: it would be a no-op for those fields, and for
+      // the store good ones a barrier would not have helped anyway, since
+      // ZBarrier::barrier() returns from its fast path without healing when the
+      // pointer is already load good.
+      if (ZPointer::is_store_good(o)) {
+        needs_follow = true;
+      }
+
+      const zaddress addr = ZPointer::is_load_good(o)
+          ? ZPointer::uncolor(o)
+          : ZBarrier::load_barrier_on_oop_field(p);
+      if (is_null(addr)) {
