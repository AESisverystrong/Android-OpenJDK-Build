@@ -905,6 +906,29 @@ void ZDirector::run_thread() {
   // Main loop
   while (wait_for_tick()) {
     ZDirectorStats stats = sample_stats();
+
+    // Check the ZFreeze trigger file. Doing it here rather than from a
+    // dedicated thread avoids introducing another GC thread lifecycle, and the
+    // director already runs at a fixed, low frequency. The probe itself is
+    // throttled by ZFreezeMinPollMillis.
+    if (ZFreeze::poll() && !ZDriver::major()->is_busy()) {
+      // The cause matters. ZDriverMajor::collect_young() only runs
+      // ZYoungType::major_full_preclean - "collect young generation and promote
+      // everything to old generation" - when should_preclean_young() says so,
+      // and GCCause::_z_timer is explicitly in the list that does NOT.
+      //
+      // Without the preclean, the live young generation is still outside the
+      // set that gets frozen at the following old mark start, so the frozen set
+      // is born holding out-edges into young space. Those targets are then
+      // collected while the frozen pages still point at them.
+      //
+      // _java_lang_system_gc precleans and, per should_clear_soft_references(),
