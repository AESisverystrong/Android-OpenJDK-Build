diff --git a/src/hotspot/share/gc/z/zPage.hpp b/src/hotspot/share/gc/z/zPage.hpp
index e07b338c..c27d0e50 100644
--- a/src/hotspot/share/gc/z/zPage.hpp
+++ b/src/hotspot/share/gc/z/zPage.hpp
@@ -67,6 +67,23 @@ private:
   uint64_t             _last_used;
   ZPhysicalMemory      _physical;
   ZListNode<ZPage>     _node;
+  // ZFreeze: permanent (frozen) page support.
+  //
+  // A permanent page is unconditionally live. It is never marked, never
+  // traversed by marking, never relocated and never freed.
+  //
+  // A reference store into a permanent page may create an out-edge that
