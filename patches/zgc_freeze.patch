+      // CollectedHeap::collect(), so -XX:+DisableExplicitGC does not block it.
+      start_major_gc(stats, GCCause::_java_lang_system_gc);
+      continue;
+    }
+
     if (!start_gc(stats)) {
       adjust_gc(stats);
     }
