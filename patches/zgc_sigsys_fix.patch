@@ -89,6 +89,7 @@
 # include <sys/select.h>
 # include <pthread.h>
 # include <signal.h>
+# include <setjmp.h>
 # include <endian.h>
 # include <errno.h>
 # include <dlfcn.h>
@@ -3071,17 +3072,54 @@
 }
 
 // Check numa dependent syscalls
+// On Android, seccomp may deliver SIGSYS (instead of returning ENOSYS) for forbidden
+// syscalls such as get_mempolicy. Catch SIGSYS so the process does not die.
+static sigjmp_buf numa_syscall_jmpbuf;
+static volatile bool numa_syscall_jmpbuf_valid = false;
+
+static void numa_sigsys_handler(int sig) {
+  if (numa_syscall_jmpbuf_valid) {
+    siglongjmp(numa_syscall_jmpbuf, 1);
+  }
+  // Unexpected SIGSYS - restore default and re-raise
+  signal(SIGSYS, SIG_DFL);
+  raise(SIGSYS);
+}
+
 static bool numa_syscall_check() {
   // NUMA APIs depend on several syscalls. E.g., get_mempolicy is required for numa_get_membind and
   // numa_get_interleave_mask. But these dependent syscalls can be unsupported for various reasons.
-  // Especially in dockers, get_mempolicy is not allowed with the default configuration. So it's necessary
-  // to check whether the syscalls are available. Currently, only get_mempolicy is checked since checking
-  // others like mbind would cause unexpected side effects.
+  // Especially in dockers / Android, get_mempolicy is not allowed with the default configuration.
+  // So it's necessary to check whether the syscalls are available. Currently, only get_mempolicy
+  // is checked since checking others like mbind would cause unexpected side effects.
 #ifdef SYS_get_mempolicy
+  struct sigaction sa_old, sa_new;
+  memset(&sa_new, 0, sizeof(sa_new));
+  sa_new.sa_handler = numa_sigsys_handler;
+  sigemptyset(&sa_new.sa_mask);
+  sa_new.sa_flags = 0;
+
+  if (sigaction(SIGSYS, &sa_new, &sa_old) != 0) {
+    // Could not install handler; fall through to normal check
+  }
+
+  numa_syscall_jmpbuf_valid = true;
+  if (sigsetjmp(numa_syscall_jmpbuf, 1) != 0) {
+    // Caught SIGSYS from the syscall
+    numa_syscall_jmpbuf_valid = false;
+    sigaction(SIGSYS, &sa_old, nullptr);
+    return false;
+  }
+
   int dummy = 0;
   if (syscall(SYS_get_mempolicy, &dummy, nullptr, 0, (void*)&dummy, 3) == -1) {
+    numa_syscall_jmpbuf_valid = false;
+    sigaction(SIGSYS, &sa_old, nullptr);
     return false;
   }
+
+  numa_syscall_jmpbuf_valid = false;
+  sigaction(SIGSYS, &sa_old, nullptr);
 #endif
 
   return true;
