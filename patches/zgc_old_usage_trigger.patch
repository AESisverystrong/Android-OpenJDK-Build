diff --git a/src/hotspot/share/gc/z/zDirector.cpp b/src/hotspot/share/gc/z/zDirector.cpp
index 417ac33a6..625a6b186 100644
--- a/src/hotspot/share/gc/z/zDirector.cpp
+++ b/src/hotspot/share/gc/z/zDirector.cpp
@@ -409,6 +409,26 @@ static bool rule_major_timer(const ZDirectorStats& stats) {
   return time_until_gc <= 0;
 }
 
+static bool rule_major_old_usage(const ZDirectorStats& stats) {
+  if (ZOldUsageTriggerPercent == 0) {
+    // Rule disabled
+    return false;
+  }
+
+  // Perform GC if the old generation occupies too much of the heap. Unlike the
+  // other major rules this one is a hard threshold rather than a prediction: it
+  // does not wait for the cycle statistics to become trustable, and it does not
+  // try to estimate whether the collection would pay for itself.
+  const size_t soft_max_capacity = stats._heap._soft_max_heap_size;
+  const size_t old_used = stats._old_stats._general._used;
+  const double old_used_percent = percent_of(old_used, soft_max_capacity);
+
+  log_debug(gc, director)("Rule Major: Old Usage, OldUsed: %.1f%%, Threshold: " UINTX_FORMAT "%%",
+                          old_used_percent, ZOldUsageTriggerPercent);
+
+  return old_used_percent >= double(ZOldUsageTriggerPercent);
+}
+
 static bool rule_major_warmup(const ZDirectorStats& stats) {
   if (ZCollectionIntervalOnly) {
     // Rule disabled
@@ -621,6 +641,10 @@ static GCCause::Cause make_major_gc_decision(const ZDirectorStats& stats) {
     return GCCause::_no_gc;
   }
 
+  if (rule_major_old_usage(stats)) {
+    return GCCause::_z_high_usage;
+  }
+
   if (rule_major_timer(stats)) {
     return GCCause::_z_timer;
   }
